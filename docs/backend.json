
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "type": "object",
      "description": "Represents a single business or store instance.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string", "default": "PHP" },
        "taxRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currency", "createdAt", "updatedAt"]
    },
    "B2BClient": {
      "title": "B2BClient",
      "type": "object",
      "description": "Business clients who can purchase on credit.",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "outstandingBalance": { "type": "number", "default": 0 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      },
      "required": ["id", "tenantId", "name", "outstandingBalance"]
    },
    "Reconciliation": {
      "title": "Reconciliation",
      "type": "object",
      "description": "Logs of credit payments made by B2B clients.",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "clientId": { "type": "string" },
        "amountPaid": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["id", "tenantId", "clientId", "amountPaid", "date"]
    },
    "Transaction": {
      "title": "Transaction",
      "type": "object",
      "description": "A POS transaction record.",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "transactionDate": { "type": "string", "format": "date-time" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "credit"] },
        "clientId": { "type": "string", "description": "Required if paymentMethod is 'credit'" },
        "status": { "type": "string" },
        "cashierId": { "type": "string" }
      },
      "required": ["id", "tenantId", "transactionDate", "totalAmount", "paymentMethod", "status", "cashierId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/tenants/{tenantId}/b2bClients/{clientId}",
        "definition": {
          "entityName": "B2BClient",
          "schema": { "$ref": "#/backend/entities/B2BClient" },
          "description": "Business clients for a specific tenant."
        }
      },
      {
        "path": "/tenants/{tenantId}/reconciliations/{reconciliationId}",
        "definition": {
          "entityName": "Reconciliation",
          "schema": { "$ref": "#/backend/entities/Reconciliation" },
          "description": "Payment logs for B2B client account settlement."
        }
      }
    ]
  }
}
