
{
  "entities": {
    "Tenant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tenant",
      "type": "object",
      "description": "Represents a single business entity or store owner within the FreshTally multi-tenant application.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "subscriptionPlan": {
          "type": "string",
          "enum": ["free", "basic", "pro", "enterprise"]
        },
        "currency": {
          "type": "string",
          "default": "PHP"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "subscriptionPlan",
        "createdAt",
        "updatedAt"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account associated with a specific tenant.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "staff", "manager", "super_admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "email",
        "displayName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "B2BClient": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "B2BClient",
      "type": "object",
      "description": "A business client with a credit line or outstanding balance.",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "oldestUnpaidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "name", "outstandingBalance", "createdAt", "updatedAt"]
    },
    "PlatformBroadcast": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PlatformBroadcast",
      "type": "object",
      "description": "System-wide announcements.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string", "enum": ["info", "warning", "critical"] },
        "activeUntil": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "priority", "activeUntil", "createdAt"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "sku": { "type": "string" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "name", "price", "stock", "isActive"]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["cash", "card", "credit"] },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Sale"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "totalAmount", "paymentType", "type", "createdAt"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "description", "amount", "category", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/platform_broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/backend/entities/PlatformBroadcast" },
      "description": "Global broadcasts."
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/backend/entities/Tenant" },
      "description": "Tenant root."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles."
    },
    "/tenants/{tenantId}/b2bClients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/B2BClient" },
      "description": "B2B client AR data."
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Products."
    },
    "/tenants/{tenantId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/backend/entities/Transaction" },
      "description": "Sales records."
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/backend/entities/Expense" },
      "description": "Business expenses."
    }
  }
}
