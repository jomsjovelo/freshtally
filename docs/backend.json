{
  "entities": {
    "Tenant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tenant",
      "type": "object",
      "description": "Represents a single business entity or store owner within the FreshTally multi-tenant application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Tenant entity."
        },
        "name": {
          "type": "string",
          "description": "The legal or common name of the tenant's business."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the tenant record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the tenant record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account associated with a specific tenant, used for role-based access control.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "tenantId": {
          "type": "string",
          "description": "Reference to the Tenant this user belongs to."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "role": {
          "type": "string",
          "description": "The role of the user (owner, staff, super_admin)."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "email",
        "displayName",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformBroadcast": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PlatformBroadcast",
      "type": "object",
      "description": "System-wide announcements displayed to users on their dashboards.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        },
        "activeUntil": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "message", "priority", "activeUntil", "createdAt"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a salable item managed by the inventory system.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "sku": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "name",
        "price",
        "sku",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "InventoryItem",
      "type": "object",
      "description": "Tracks the stock level and inventory details for a specific product.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "stockLevel": {
          "type": "number"
        },
        "minStockLevel": {
          "type": "number"
        },
        "lastStockUpdate": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "productId",
        "stockLevel",
        "minStockLevel",
        "lastStockUpdate",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Transaction",
      "type": "object",
      "description": "Represents a single point-of-sale transaction.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "transactionDate": {
          "type": "string",
          "format": "date-time"
        },
        "totalAmount": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "staffUserId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "transactionDate",
        "totalAmount",
        "paymentMethod",
        "status",
        "staffUserId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SaleItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SaleItem",
      "type": "object",
      "description": "Represents a specific product included in a transaction.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "transactionId": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "quantity": {
          "type": "number"
        },
        "unitPrice": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "transactionId",
        "productId",
        "productName",
        "quantity",
        "unitPrice",
        "subtotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Records a business expense.",
      "properties": {
        "id": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "expenseDate": {
          "type": "string",
          "format": "date-time"
        },
        "category": {
          "type": "string"
        },
        "receiptUrl": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenantId",
        "description",
        "amount",
        "expenseDate",
        "category",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/platform_broadcasts/{broadcastId}": {
      "schema": {
        "$ref": "#/backend/entities/PlatformBroadcast"
      },
      "description": "Global broadcasts for all users."
    },
    "/tenants/{tenantId}": {
      "schema": {
        "$ref": "#/backend/entities/Tenant"
      },
      "description": "Root collection for each business tenant."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/User"
      },
      "description": "Profiles for all users."
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": {
        "$ref": "#/backend/entities/Product"
      },
      "description": "Products belonging to a specific tenant."
    },
    "/tenants/{tenantId}/inventoryItems/{inventoryItemId}": {
      "schema": {
        "$ref": "#/backend/entities/InventoryItem"
      },
      "description": "Inventory items for a specific tenant."
    },
    "/tenants/{tenantId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/backend/entities/Transaction"
      },
      "description": "Point-of-sale transactions specific to a tenant."
    },
    "/tenants/{tenantId}/transactions/{transactionId}/saleItems/{saleItemId}": {
      "schema": {
        "$ref": "#/backend/entities/SaleItem"
      },
      "description": "Sale items within a transaction."
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/backend/entities/Expense"
      },
      "description": "Business expenses incurred by a specific tenant."
    }
  }
}