
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "type": "object",
      "description": "Represents a single business or store instance in the SaaS platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "subscriptionPlan": { "type": "string", "enum": ["basic", "pro", "enterprise"] },
        "expiryDate": { "type": "string", "format": "date-time" },
        "ownerEmail": { "type": "string", "format": "email" },
        "ownerName": { "type": "string" },
        "isVerified": { "type": "boolean", "default": false },
        "logoUrl": { "type": "string" },
        "currency": { "type": "string", "default": "PHP" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status", "subscriptionPlan", "expiryDate"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User account details including SaaS role and tenant association.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "owner", "staff"] },
        "tenantId": { "type": "string", "description": "Null if super_admin" },
        "name": { "type": "string" }
      },
      "required": ["uid", "role", "email"]
    },
    "PlatformBroadcast": {
      "title": "PlatformBroadcast",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string", "enum": ["info", "warning", "critical"] },
        "activeUntil": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "staffLimit": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/tenants/{tenantId}",
        "definition": {
          "entityName": "Tenant",
          "schema": { "$ref": "#/backend/entities/Tenant" },
          "description": "Root tenant configuration."
        }
      },
      {
        "path": "/userProfiles/{uid}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Global user profiles."
        }
      },
      {
        "path": "/platform_broadcasts/{broadcastId}",
        "definition": {
          "entityName": "PlatformBroadcast",
          "schema": { "$ref": "#/backend/entities/PlatformBroadcast" },
          "description": "System-wide announcements."
        }
      },
      {
        "path": "/subscription_plans/{planId}",
        "definition": {
          "entityName": "SubscriptionPlan",
          "schema": { "$ref": "#/backend/entities/SubscriptionPlan" },
          "description": "Available billing tiers."
        }
      }
    ]
  }
}
