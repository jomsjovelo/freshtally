rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Hardened for multi-tenant SaaS with propagation resilience.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == 'super_admin';
    }

    function isTenantMember(tenantId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Resilience: Rely on the user's profile to define membership.
      // This ensures that even if the Tenant document is deleted, the user can 
      // still access their data or see appropriate recovery UI.
      return isSignedIn() && exists(userPath) && get(userPath).data.tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && 
             get(userPath).data.role == 'owner' && 
             get(userPath).data.tenantId == tenantId;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /**
     * @description System broadcasts visible to all signed-in users.
     */
    match /platform_broadcasts/{broadcastId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    /**
     * @description User profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Tenant metadata.
     */
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isTenantOwner(tenantId) || isSuperAdmin();
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    /**
     * @description Tenant sub-collections (Products, Transactions, Expenses, etc.)
     */
    match /tenants/{tenantId}/{allSubcollections=**} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create, update: if isTenantMember(tenantId);
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }
  }
}