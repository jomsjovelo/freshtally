
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    
    // Safely retrieve user data, returning null if the document doesn't exist
    function getUserData() {
      return exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data 
        : null;
    }
    
    function isSuperAdmin() { 
      let profile = getUserData();
      return isSignedIn() && profile != null && profile.role == 'super_admin'; 
    }
    
    function isMemberOf(tenantId) { 
      let profile = getUserData();
      return isSignedIn() && profile != null && profile.tenantId == tenantId; 
    }
    
    function isTenantOwner(tenantId) { 
      let profile = getUserData();
      return isMemberOf(tenantId) && profile.role == 'owner'; 
    }
    
    function isTenantActive(tenantId) { 
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'active'; 
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow any signed-in user to 'get' a tenant to verify Store IDs or join
      allow get: if isSignedIn() || isSuperAdmin();
      allow list: if isSuperAdmin();
      
      // Allow owners to create their tenant during registration
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      
      allow update: if (isTenantOwner(tenantId) && request.resource.data.status == resource.data.status) || isSuperAdmin();
      
      match /b2bClients/{clientId} {
        allow read: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
        allow write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }
      
      match /reconciliations/{recId} {
        allow read: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
        allow write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }

      match /products/{productId} {
        allow read: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
        allow write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }

      match /transactions/{txId} {
        allow read: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
        allow create: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }
    }
  }
}
