rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY ARCHITECTURAL STABILITY V7
     * Resilient multi-tenant isolation with defensive context verification.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             get(userPath).data.get('tenantId', '') == tenantId;
    }

    function isTenantOwner(tenantId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             get(userPath).data.get('tenantId', '') == tenantId &&
             get(userPath).data.get('role', 'staff') == 'owner';
    }

    function isSuperAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(userPath) && 
             get(userPath).data.get('role', 'staff') == 'super_admin';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (isTenantOwner(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();

      // Sub-collections strictly scoped to verified tenant members
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      }
    }
  }
}