rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && getRole() == 'super_admin';
    }

    match /users/{userId} {
      allow get, update: if isSignedIn() && (request.auth.uid == userId || getRole() == 'super_admin');
      allow create: if isSignedIn();
      allow list: if isSignedIn() && getRole() == 'super_admin';
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (getRole() == 'owner' || getRole() == 'staff' || getRole() == 'super_admin');
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (getRole() == 'owner' || getRole() == 'super_admin');

      match /transactions/{txId} {
        allow read, write: if isSignedIn();
      }

      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || getRole() == 'super_admin';
        allow write: if isSignedIn() && (getRole() == 'owner' || getRole() == 'super_admin');
      }

      match /expenses/{expId} {
        allow read, write: if isSignedIn() && (getRole() == 'owner' || getRole() == 'super_admin') && isTenantMember(tenantId);
      }

      match /b2bClients/{clientId} {
        allow read, write: if isSignedIn() && (getRole() == 'owner' || getRole() == 'super_admin') && isTenantMember(tenantId);
      }

      match /reconciliations/{recId} {
        allow read, write: if isSignedIn() && (getRole() == 'owner' || getRole() == 'super_admin') && isTenantMember(tenantId);
      }
    }
  }
}