rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let p = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(p) && get(p).data.role == 'super_admin';
    }
    
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      let p = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let t = /databases/$(database)/documents/tenants/$(tId);
      
      // Dual-layered verification for resilience during indexing/propagation
      let profileMatch = exists(p) && string(get(p).data.tenantId) == string(tId);
      let ownerMatch = exists(t) && get(t).data.ownerEmail == request.auth.token.email;
      
      return profileMatch || ownerMatch;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      allow update: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}