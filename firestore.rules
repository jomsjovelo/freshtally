rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Hardened for multi-tenant SaaS resilience.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'staff') == 'super_admin';
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'staff') == 'owner';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update, delete: if isSignedIn() && (isTenantOwner(tenantId) || isSuperAdmin());

      match /{allSubcollections=**} {
        allow get, list: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
        allow create, update, delete: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      }
    }
  }
}