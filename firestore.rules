rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Get user profile data (cached per request)
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if user belongs to a specific tenant
    function isTenantMember(tenantId) {
      return isSignedIn() && getUserData().tenantId == tenantId;
    }

    // Helper: Get user role
    function getRole() {
      return getUserData().get('role', 'none');
    }

    // User Profile: Strict self-access
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Platform Level: Global broadcasts for all authorized users
    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
    }

    // Multi-tenant Root and Sub-collections
    match /tenants/{tenantId} {
      // Basic tenant identification
      allow read: if isTenantMember(tenantId);
      allow create: if isSignedIn();
      allow update: if isTenantMember(tenantId) && (getRole() == 'owner' || getRole() == 'super_admin');

      // Transactions: Operational data shared by all tenant staff/owners
      match /transactions/{txId} {
        allow read, write: if isTenantMember(tenantId);
      }

      // Products: Read by staff, managed by owners/managers
      match /products/{productId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantMember(tenantId) && (getRole() == 'owner' || getRole() == 'manager' || getRole() == 'super_admin');
      }

      // Financials: Restricted strictly to owners/admins
      match /expenses/{expId} {
        allow read, write: if isTenantMember(tenantId) && (getRole() == 'owner' || getRole() == 'super_admin');
      }
      match /b2bClients/{clientId} {
        allow read, write: if isTenantMember(tenantId) && (getRole() == 'owner' || getRole() == 'super_admin');
      }
      match /reconciliations/{recId} {
        allow read, write: if isTenantMember(tenantId) && (getRole() == 'owner' || getRole() == 'super_admin');
      }
    }
  }
}