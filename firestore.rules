rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Direct profile fetch without existence check to minimize latency and race conditions
    function getProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }
    
    // Check if user is a super admin
    function isSuperAdmin() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.role == 'super_admin';
    }
    
    // Direct check for tenant membership
    function isMemberOf(tId) {
      let profile = getProfile();
      return isSignedIn() && profile != null && string(profile.tenantId) == string(tId);
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Direct access for authorized members or super admins
      allow read: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      // Allow owners to create their tenant document
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      
      // Allow updates if owner or super admin
      allow update: if isSuperAdmin() || (isMemberOf(tenantId) && getProfile().role == 'owner');
      
      // Subcollections using direct membership check
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}