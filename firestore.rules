rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helpers for authorization
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == 'super_admin';
    }
    
    // Direct Owner Check: Resilient to profile indexing delays
    function isOwner(tId) {
      let tPath = /databases/$(database)/documents/tenants/$(tId);
      let email = request.auth.token.email;
      return isSignedIn() && exists(tPath) && 
             email != null && 
             get(tPath).data.get('ownerEmail', '').lower() == email.lower();
    }

    // Staff Check: Direct profile association
    function isStaff(tId) {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(pPath) && 
             get(pPath).data.get('tenantId', '') == tId;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (isSuperAdmin() || isOwner(tenantId) || isStaff(tenantId));
      
      // Recursive match for all sub-collections (products, transactions, clients, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isSuperAdmin() || isOwner(tenantId) || isStaff(tenantId));
      }
    }
  }
}