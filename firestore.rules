rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // CORE AUTHORIZATION HELPERS
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(pPath) && get(pPath).data.role == 'super_admin';
    }
    
    // Robust membership check with direct email ownership fallback.
    // This bypasses propagation lag by verifying the user's email against the tenant root.
    function canAccessTenant(tId) {
      if (!isSignedIn()) { return false; }
      if (isSuperAdmin()) { return true; }

      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Profile Check (Primary)
      let hasProfileAccess = exists(pPath) && get(pPath).data.tenantId == tId;
      
      // 2. Direct Ownership Fallback (Immediate/Resilient)
      // We use lower() for case-insensitive comparison to handle registration variations.
      let isOwnerFallback = exists(tPath) && 
                           request.auth.token.email != null && 
                           get(tPath).data.ownerEmail.lower() == request.auth.token.email.lower();
      
      return hasProfileAccess || isOwnerFallback;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, update: if canAccessTenant(tenantId);
      
      // RECURSIVE DATA ACCESS: Hardened for all store sub-collections.
      match /{allSubcollections=**} {
        allow read, write: if canAccessTenant(tenantId);
      }
    }
  }
}