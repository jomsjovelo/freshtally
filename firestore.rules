rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      if (!isSignedIn()) return false;
      let p = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(p) && get(p).data.role == 'super_admin';
    }
    
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tPath = /databases/$(database)/documents/tenants/$(tId);
      
      // Dual-layered verification for resilience during indexing/propagation.
      // 1. Direct Ownership Check: Compares token email with tenant ownerEmail (resilient fallback).
      let isOwnerByEmail = exists(tPath) && get(tPath).data.ownerEmail.toLower() == request.auth.token.email.toLower();
      
      // 2. Profile Check: Verifies tenantId stored in the user's profile document.
      let isMemberByProfile = exists(pPath) && get(pPath).data.tenantId == tId;
      
      return isOwnerByEmail || isMemberByProfile;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}