rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Version: 1.8.3 - Atomic Identity Handshake Hardening
    // Defensive exists() guards for all member-based access.
    // Explicit list operation scoping for multi-tenancy.
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isMember(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             getUserProfile().tenantId == tenantId &&
             exists(/databases/$(database)/documents/tenants/$(tenantId));
    }

    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             getUserProfile().role == role;
    }

    match /userProfiles/{userId} {
      allow get, list, create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow get: if isMember(tenantId);
      allow update: if isMember(tenantId) && (hasRole('owner') || hasRole('super_admin'));

      match /products/{productId} {
        allow get, list: if isMember(tenantId);
        allow create, update: if isMember(tenantId);
        allow delete: if isMember(tenantId) && (hasRole('owner') || hasRole('super_admin'));
      }

      match /transactions/{transactionId} {
        allow get, list: if isMember(tenantId);
        allow create: if isMember(tenantId);
        allow update, delete: if isMember(tenantId) && (hasRole('owner') || hasRole('super_admin'));

        match /items/{itemId} {
          allow get, list: if isMember(tenantId);
          allow create, update, delete: if isMember(tenantId);
        }
      }

      match /expenses/{expenseId} {
        allow get, list: if isMember(tenantId) && (hasRole('owner') || hasRole('manager') || hasRole('super_admin'));
        allow create, update, delete: if isMember(tenantId) && (hasRole('owner') || hasRole('super_admin'));
      }

      match /b2bClients/{clientId} {
        allow get, list: if isMember(tenantId);
        allow create, update, delete: if isMember(tenantId) && (hasRole('owner') || hasRole('super_admin'));
      }
      
      match /reconciliations/{recId} {
        allow list, get: if isMember(tenantId);
        allow create: if isMember(tenantId);
      }
    }

    match /platform_broadcasts/{broadcastId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if hasRole('super_admin');
    }
  }
}
