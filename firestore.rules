rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Hardened for multi-tenant SaaS resilience.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return userExists() && getUserData().role == 'super_admin';
    }

    function isTenantMember(tenantId) {
      return userExists() && getUserData().tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && getUserData().role == 'owner';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isTenantOwner(tenantId) || isSuperAdmin();
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();

      match /{allSubcollections=**} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if isTenantMember(tenantId);
      }
    }
  }
}