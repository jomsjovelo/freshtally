rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Safely fetch profile data without crashing the rule evaluation
    function getProfile() {
      let path = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    // Check if user is a super admin
    function isSuperAdmin() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.role == 'super_admin';
    }
    
    // Check for tenant membership with multiple layers of verification
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      // Layer 1: Check user profile (standard path)
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      if (exists(profilePath)) {
        let profile = get(profilePath).data;
        if (profile != null && string(profile.tenantId) == string(tId)) return true;
      }
      
      // Layer 2: Check tenant ownership directly (resilient fallback for new owners)
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      if (exists(tenantPath)) {
        let tenant = get(tenantPath).data;
        if (tenant != null && tenant.ownerEmail == request.auth.token.email) return true;
      }
      
      return false;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isMemberOf(tenantId) && (isSuperAdmin() || getProfile().role == 'owner'));
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}