rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    
    // Helper to get the user's profile data
    function getProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }
    
    // Check if user is a super admin
    function isSuperAdmin() { 
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == 'super_admin'; 
    }
    
    // Check if user belongs to the specified tenant
    function isMemberOf(tenantId) { 
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && string(get(profilePath).data.tenantId) == string(tenantId); 
    }
    
    // Check if the tenant is active
    function isTenantActive(tenantId) { 
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      return exists(tenantPath) && get(tenantPath).data.status == 'active'; 
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow any signed-in user to 'get' a tenant to verify IDs
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      
      // Allow owners to create their tenant
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      
      // Allow updates if owner or super admin
      allow update: if isSuperAdmin() || (isMemberOf(tenantId) && getProfile().role == 'owner' && request.resource.data.status == resource.data.status);
      
      match /b2bClients/{clientId} {
        allow read, write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }
      
      match /reconciliations/{recId} {
        allow read, write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }

      match /products/{productId} {
        allow read, write: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }

      match /transactions/{txId} {
        allow read, create: if (isMemberOf(tenantId) && isTenantActive(tenantId)) || isSuperAdmin();
      }
    }
  }
}