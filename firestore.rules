
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY ATOMIC SECURITY ARCHITECTURE V15
     * Hardened isolation with strict exists() guards and atomic verification.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Defensive helper to check user role/tenant membership
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isTenantMember(tenantId) {
      let data = getUserData();
      return isSignedIn() && data != null && data.tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      let data = getUserData();
      return isSignedIn() && data != null && data.tenantId == tenantId && data.role == 'owner';
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'super_admin';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      // Direct tenant access requires membership or superadmin
      allow get: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (isTenantOwner(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();

      // Deep sub-collection scoping
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      }
    }
  }
}
