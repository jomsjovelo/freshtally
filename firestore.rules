rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Heartbeat: Security Sync V3 - Resilient Ownership Fallback
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      if (!isSignedIn()) return false;
      let p = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(p) && get(p).data.role == 'super_admin';
    }
    
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Profile Layer: Check the tenantId stored in the user's verified profile
      let isProfileMember = exists(profilePath) && get(profilePath).data.tenantId == tId;
      
      // 2. Token Layer Fallback: Check if the user's auth email matches the tenant ownerEmail
      // This is more resilient immediately after registration before profile indexing completes.
      let isOwnerByEmail = exists(tenantPath) && 
                          request.auth.token.email != null &&
                          get(tenantPath).data.ownerEmail.toLower() == request.auth.token.email.toLower();
      
      return isProfileMember || isOwnerByEmail;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Owners can create their own tenant node
      allow create: if isSignedIn();
      
      // Access allowed for members, owners (via email fallback), or system admins
      allow read, update: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      // Cascade permissions to all sub-nodes (products, transactions, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}