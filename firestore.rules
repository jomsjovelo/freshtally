rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Hardened for multi-tenant SaaS with propagation resilience and missing document handling.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      
      return isSignedIn() && (
        // Check 1: User is the explicit owner recorded on the tenant doc (if it exists)
        (exists(tenantPath) && get(tenantPath).data.ownerUid == request.auth.uid) ||
        // Check 2: User profile document links them to this tenant
        (exists(userPath) && get(userPath).data.tenantId == tenantId)
      );
    }

    function isTenantOwner(tenantId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);

      return isSignedIn() && (
        (exists(tenantPath) && get(tenantPath).data.ownerUid == request.auth.uid) ||
        (exists(userPath) && get(userPath).data.role == 'owner' && get(userPath).data.tenantId == tenantId)
      );
    }

    function isSuperAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userPath) && get(userPath).data.role == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /**
     * @description System broadcasts visible to all signed-in users.
     */
    match /platform_broadcasts/{broadcastId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    /**
     * @description User profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Tenant metadata.
     */
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isTenantOwner(tenantId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Product catalog.
     */
    match /tenants/{tenantId}/products/{productId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update, delete: if isTenantMember(tenantId);
    }

    /**
     * @description Business expenses.
     */
    match /tenants/{tenantId}/expenses/{expenseId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update: if isTenantMember(tenantId);
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    /**
     * @description Point-of-Sale Transactions.
     */
    match /tenants/{tenantId}/transactions/{transactionId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update, delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    /**
     * @description B2B Clients.
     */
    match /tenants/{tenantId}/b2bClients/{clientId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create, update: if isTenantMember(tenantId);
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }
  }
}