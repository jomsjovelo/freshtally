rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY ARCHITECTURAL STABILITY V11
     * Resilient multi-tenant isolation with atomic verification.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Atomic helper to get user data directly from the source of truth
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantMember(tenantId) {
      let data = getUserData();
      return isSignedIn() && data.tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      let data = getUserData();
      return isSignedIn() && data.tenantId == tenantId && data.role == 'owner';
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && data.role == 'super_admin';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (isTenantOwner(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();

      // Sub-collections strictly scoped to verified tenant members
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      }
    }
  }
}