rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // REDEPLOY TRIGGER: V6 - RECURSIVE AUTHORIZATION HARDENING
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Efficiently verify tenant access using profile data or direct ownership fallback
    function canAccessTenant(tId) {
      if (!isSignedIn()) { return false; }

      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Direct Ownership Fallback (Most resilient to replication lag for Owners)
      let isOwner = exists(tenantPath) && 
                    request.auth.token.email != null && 
                    get(tenantPath).data.ownerEmail.lower() == request.auth.token.email.lower();
      
      if (isOwner) return true;

      // 2. Profile Check (Source of truth for staff and super admins)
      let hasProfile = exists(profilePath);
      if (hasProfile) {
        let profile = get(profilePath).data;
        return profile.role == 'super_admin' || profile.tenantId == tId;
      }
      
      return false;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'super_admin'));
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'super_admin'));
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      // Apply the check at the root level and all sub-paths recursively.
      allow read, write: if canAccessTenant(tenantId);
      
      match /{allSubcollections=**} {
        allow read, write: if canAccessTenant(tenantId);
      }
    }
  }
}