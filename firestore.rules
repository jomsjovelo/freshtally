
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function getUserProfile() { return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data; }
    function isMemberOf(tenantId) { return isSignedIn() && getUserProfile().tenantId == tenantId; }
    function isTenantAdmin(tenantId) { return isMemberOf(tenantId) && (getUserProfile().role == 'owner' || getUserProfile().role == 'admin'); }

    match /userProfiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || getUserProfile().role == 'owner');
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /tenants/{tenantId} {
      allow get: if isMemberOf(tenantId);
      allow create: if isSignedIn();
      allow update: if isTenantAdmin(tenantId);
      
      match /b2bClients/{clientId} {
        allow read: if isMemberOf(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }
      
      match /reconciliations/{recId} {
        allow read: if isMemberOf(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /products/{productId} {
        allow read: if isMemberOf(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      match /transactions/{txId} {
        allow read: if isMemberOf(tenantId);
        allow create: if isMemberOf(tenantId);
        allow update: if isTenantAdmin(tenantId);

        match /transactionItems/{itemId} {
          allow read, create: if isMemberOf(tenantId);
        }
      }
    }
  }
}
