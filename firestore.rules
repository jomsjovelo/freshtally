rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Hardened check for membership using exists() to prevent evaluation crashes
    function isMember(tenantId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.tenantId == tenantId;
    }

    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == role;
    }

    match /userProfiles/{userId} {
      allow get, list, create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /tenants/{tenantId} {
      allow get: if isMember(tenantId);
      allow create: if isSignedIn();
      allow update: if isMember(tenantId) && hasRole('owner');

      match /products/{productId} {
        allow get, list: if isMember(tenantId);
        allow create, update: if isMember(tenantId);
        allow delete: if isMember(tenantId) && hasRole('owner');
      }

      match /transactions/{transactionId} {
        allow get, list: if isMember(tenantId);
        allow create: if isMember(tenantId);
        allow update, delete: if isMember(tenantId) && hasRole('owner');

        match /items/{itemId} {
          allow get, list: if isMember(tenantId);
          allow create, update, delete: if isMember(tenantId);
        }
      }

      match /expenses/{expenseId} {
        allow get, list: if isMember(tenantId) && hasRole('owner');
        allow create, update: if isMember(tenantId) && hasRole('owner');
        allow delete: if isMember(tenantId) && hasRole('owner');
      }

      match /b2bClients/{clientId} {
        allow get, list: if isMember(tenantId);
        allow create, update, delete: if isMember(tenantId) && hasRole('owner');
      }
    }

    match /platform_broadcasts/{broadcastId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if hasRole('super_admin');
    }
  }
}