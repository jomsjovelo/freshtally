rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // CORE AUTHORIZATION HELPERS
    // Optimized for speed and resilience against propagation latency.
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Get the current user's profile - cached per request
    function getProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(pPath) && get(pPath).data.role == 'super_admin';
    }
    
    // Membership Check: Validates if user belongs to the tenant via their profile link.
    // This is the most robust check as it uses the authenticated UID as the primary key.
    function isMember(tId) {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(pPath) && get(pPath).data.tenantId == tId;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (isSuperAdmin() || isMember(tenantId));
      
      // RECURSIVE DATA ACCESS
      // Ensures products, transactions, and clients are perfectly gated by tenant membership.
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isSuperAdmin() || isMember(tenantId));
      }
    }
  }
}