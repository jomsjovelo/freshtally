rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helpers for resilient authorization
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == 'super_admin';
    }
    
    // Hardened Membership Check: Checks Profile OR direct email ownership
    // Optimized to be resilient to propagation delays after registration
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Token Layer Check (Fastest & most resilient fallback for owners)
      let userEmail = request.auth.token.email;
      let isOwnerByEmail = exists(tenantPath) && 
                          userEmail != null &&
                          get(tenantPath).data.ownerEmail != null &&
                          get(tenantPath).data.ownerEmail.lower() == userEmail.lower();
      
      if (isOwnerByEmail) return true;

      // 2. Profile Layer Check (For staff and secondary verification)
      let hasProfile = exists(profilePath);
      if (!hasProfile) return false;
      
      let profileData = get(profilePath).data;
      return profileData.tenantId == tId;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow creation for any signed-in user initializing their store
      allow create: if isSignedIn();
      
      // Access allowed for verified members, owners, or super admins
      // For the tenant document itself, we can use resource.data to avoid an extra get()
      allow read, update: if isSignedIn() && (
        isSuperAdmin() || 
        (resource != null && request.auth.token.email != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower()) ||
        isMemberOf(tenantId)
      );
      
      // Subcollection matches
      match /products/{productId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /transactions/{txId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /b2bClients/{clientId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /reconciliations/{recId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}