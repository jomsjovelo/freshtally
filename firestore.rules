rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helpers for resilient authorization
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == 'super_admin';
    }
    
    // Resilient Membership Check: Checks Profile OR direct email ownership
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Profile Layer: Check the tenantId stored in the user's profile document
      let isProfileMember = exists(profilePath) && get(profilePath).data.tenantId == tId;
      
      // 2. Token Layer Fallback: Direct ownership check via email on the tenant node
      // This is immediate and immune to profile propagation delays.
      // CEL uses .lower() instead of .toLower()
      let isOwnerByEmail = exists(tenantPath) && 
                          request.auth.token.email != null &&
                          get(tenantPath).data.ownerEmail.lower() == request.auth.token.email.lower();
      
      return isProfileMember || isOwnerByEmail;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow creation for any signed-in user initializing their store
      allow create: if isSignedIn();
      
      // Access allowed for verified members, owners, or super admins
      allow read, update: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      // Cascade permissions to all sub-nodes (products, transactions, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}