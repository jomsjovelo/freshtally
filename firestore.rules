rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Triggering deployment with an updated rule set.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && getUserData().tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId) && getUserData().role == 'owner';
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function exists() {
      return resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description System broadcasts visible to all signed-in users.
     */
    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    /**
     * @description User profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Tenant metadata.
     */
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if exists() && (isTenantOwner(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Product catalog.
     */
    match /tenants/{tenantId}/products/{productId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId) && request.resource.data.tenantId == tenantId;
      allow update: if exists() && isTenantMember(tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if exists() && isTenantMember(tenantId);
    }

    /**
     * @description Inventory tracking.
     */
    match /tenants/{tenantId}/inventoryItems/{inventoryItemId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId) && request.resource.data.tenantId == tenantId;
      allow update: if exists() && isTenantMember(tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if exists() && isTenantMember(tenantId);
    }

    /**
     * @description Point-of-Sale Transactions.
     */
    match /tenants/{tenantId}/transactions/{transactionId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId) && request.resource.data.tenantId == tenantId && request.resource.data.staffUserId == request.auth.uid;
      allow update: if exists() && isTenantMember(tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if exists() && (isTenantOwner(tenantId) || isSuperAdmin());

      match /saleItems/{saleItemId} {
        allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantMember(tenantId) && request.resource.data.tenantId == tenantId && request.resource.data.transactionId == transactionId;
        allow update: if exists() && isTenantMember(tenantId) && request.resource.data.tenantId == resource.data.tenantId;
        allow delete: if exists() && (isTenantOwner(tenantId) || isSuperAdmin());
      }
    }

    /**
     * @description Business expenses.
     */
    match /tenants/{tenantId}/expenses/{expenseId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId) && request.resource.data.tenantId == tenantId;
      allow update: if exists() && isTenantMember(tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if exists() && (isTenantOwner(tenantId) || isSuperAdmin());
    }
  }
}