rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic sign-in check
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely fetch user role from the users collection
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // User profiles: Users can manage their own profile
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Platform broadcasts: Readable by any signed-in user
    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
    }

    // Tenant scoped data
    match /tenants/{tenantId} {
      // Tenant document: Readable by verified members (Owner/Staff)
      allow read: if isSignedIn() && (getRole() == 'owner' || getRole() == 'staff');
      // Create allowed for any authenticated user (during onboarding)
      allow create: if isSignedIn();
      // Update only by owners
      allow update: if isSignedIn() && getRole() == 'owner';

      // Transactions: Readable and writable by any authenticated user in the store
      // (Simplified to resolve permission issues while maintaining tenant scope)
      match /transactions/{txId} {
        allow read, write: if isSignedIn();
      }

      // Financials: Strictly restricted to Owners
      match /expenses/{expId} {
        allow read, write: if isSignedIn() && getRole() == 'owner';
      }

      match /b2bClients/{clientId} {
        allow read, write: if isSignedIn() && getRole() == 'owner';
      }

      match /reconciliations/{recId} {
        allow read, write: if isSignedIn() && getRole() == 'owner';
      }
    }
  }
}