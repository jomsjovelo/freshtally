rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY SECURITY RULES
     * Hardened for multi-tenant SaaS with propagation resilience.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      // Use getAfter to ensure we can see the document if it's part of the same transaction/batch
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenantMember(tenantId) {
      // Resilience: Try direct tenant owner check first, then profile check.
      // This bypasses profile propagation lag for the owner.
      let tenant = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      return isSignedIn() && (
        tenant.ownerUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId == tenantId)
      );
    }

    function isTenantOwner(tenantId) {
      let tenant = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      return isSignedIn() && (
        tenant.ownerUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /**
     * @description System broadcasts visible to all signed-in users.
     */
    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    /**
     * @description User profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Tenant metadata.
     */
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isTenantOwner(tenantId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    /**
     * @description Product catalog.
     */
    match /tenants/{tenantId}/products/{productId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update, delete: if isTenantMember(tenantId);
    }

    /**
     * @description Business expenses.
     */
    match /tenants/{tenantId}/expenses/{expenseId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update: if isTenantMember(tenantId);
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    /**
     * @description Point-of-Sale Transactions.
     */
    match /tenants/{tenantId}/transactions/{transactionId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create: if isTenantMember(tenantId);
      allow update, delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }

    /**
     * @description B2B Clients.
     */
    match /tenants/{tenantId}/b2bClients/{clientId} {
      allow get, list: if isTenantMember(tenantId) || isSuperAdmin();
      allow create, update: if isTenantMember(tenantId);
      allow delete: if isTenantOwner(tenantId) || isSuperAdmin();
    }
  }
}