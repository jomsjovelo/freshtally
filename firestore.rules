rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FRESH TALLY ATOMIC SECURITY ARCHITECTURE V20
     * Forensic Hardening: Role-Based Sub-collection Shielding
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isTenantMember(tenantId) {
      let data = getUserData();
      return isSignedIn() && 
             data != null && 
             'tenantId' in data && 
             data.tenantId == tenantId;
    }

    function isTenantOwner(tenantId) {
      let data = getUserData();
      return isSignedIn() && 
             data != null && 
             'tenantId' in data && 
             data.tenantId == tenantId && 
             data.role == 'owner';
    }

    function isSuperAdmin() {
      let data = getUserData();
      return isSignedIn() && 
             data != null && 
             data.role == 'super_admin';
    }

    // --- Collection Rules ---

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow get: if isSignedIn() && (isTenantMember(tenantId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn() && (isTenantOwner(tenantId) || isSuperAdmin());
      allow delete: if isSuperAdmin();

      // --- Granular Role Isolation ---
      
      match /products/{productId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /transactions/{txId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow create: if isTenantMember(tenantId) || isSuperAdmin();
        allow update, delete: if isSuperAdmin();
      }

      // Financial sub-collections strictly shielded from 'staff'
      match /expenses/{expenseId} {
        allow read, write: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /b2bClients/{clientId} {
        allow read: if isTenantMember(tenantId) || isSuperAdmin();
        allow write: if isTenantOwner(tenantId) || isSuperAdmin();
      }

      match /reconciliations/{recId} {
        allow read, write: if isTenantOwner(tenantId) || isSuperAdmin();
      }
    }
  }
}