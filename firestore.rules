rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // CORE AUTHORIZATION HELPERS
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(pPath) && get(pPath).data.role == 'super_admin';
    }
    
    // Optimized membership check with email-based fallback for owners to bypass propagation lag.
    function canAccessTenant(tId) {
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tPath = /databases/$(database)/documents/tenants/$(tId);
      
      let hasProfileAccess = exists(pPath) && get(pPath).data.tenantId == tId;
      let isOwnerFallback = exists(tPath) && get(tPath).data.ownerEmail.lower() == request.auth.token.email.lower();
      
      return isSignedIn() && (isSuperAdmin() || hasProfileAccess || isOwnerFallback);
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if isSignedIn();
      allow read, update: if canAccessTenant(tenantId);
      
      // RECURSIVE DATA ACCESS
      // Hardened recursive match for all store sub-collections.
      match /{allSubcollections=**} {
        allow read, write: if canAccessTenant(tenantId);
      }
    }
  }
}