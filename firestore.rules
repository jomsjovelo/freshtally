rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Safely fetch profile data without crashing the rule evaluation
    function getProfile() {
      let path = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    // Check if user is a super admin
    function isSuperAdmin() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.role == 'super_admin';
    }
    
    // Robust check for tenant membership with document existence guards
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      let profile = exists(profilePath) ? get(profilePath).data : null;
      let tenant = exists(tenantPath) ? get(tenantPath).data : null;
      
      return (profile != null && string(profile.tenantId) == string(tId)) || 
             (tenant != null && tenant.ownerEmail == request.auth.token.email);
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow read if member, owner via email, or super admin
      allow read: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      
      // Allow owners to create their tenant document
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      
      // Allow updates if owner or super admin
      allow update: if isSuperAdmin() || (isMemberOf(tenantId) && (isSuperAdmin() || getProfile().role == 'owner'));
      
      // Subcollections using robust membership check
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}