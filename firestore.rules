rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Improved helper for getting profile with existence check
    function getProfile() {
      let path = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }
    
    // Check if user is a super admin
    function isSuperAdmin() {
      let profile = getProfile();
      return isSignedIn() && profile != null && profile.role == 'super_admin';
    }
    
    // Check if user belongs to the specified tenant
    function isMemberOf(tId) {
      let profile = getProfile();
      return isSignedIn() && profile != null && (string(profile.tenantId) == string(tId));
    }
    
    // Check if the tenant is active
    function isTenantActive(tId) {
      let path = /databases/$(database)/documents/tenants/$(tId);
      return exists(path) && get(path).data.status == 'active';
    }

    // Combined helper for sub-collection access with robust existence checks
    function canAccessSub(tId) {
      let profile = getProfile();
      let tenantPath = /databases/$(database)/documents/tenants/$(tId);
      
      return isSignedIn() && 
             profile != null && 
             exists(tenantPath) &&
             (string(profile.tenantId) == string(tId) || profile.role == 'super_admin') && 
             get(tenantPath).data.status == 'active';
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Basic access for discovery and verification
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      
      // Full access for authorized members
      allow read: if isMemberOf(tenantId) || isSuperAdmin();
      
      // Allow owners to create their tenant document
      allow create: if isSignedIn() && request.resource.data.ownerEmail == request.auth.token.email;
      
      // Allow updates if owner or super admin
      allow update: if isSuperAdmin() || (isMemberOf(tenantId) && getProfile().role == 'owner');
      
      // Subcollections with optimized access guards
      match /b2bClients/{clientId} {
        allow read, write: if canAccessSub(tenantId);
      }
      
      match /reconciliations/{recId} {
        allow read, write: if canAccessSub(tenantId);
      }

      match /products/{productId} {
        allow read, write: if canAccessSub(tenantId);
      }

      match /transactions/{txId} {
        allow read, create: if canAccessSub(tenantId);
      }
    }
  }
}