rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helpers for resilient authorization
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      let profilePath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == 'super_admin';
    }
    
    // Hardened Membership Check: Checks Profile AND direct email ownership fallback
    // Optimized to be resilient to propagation delays after registration
    function isMemberOf(tId) {
      if (!isSignedIn()) return false;
      
      let pPath = /databases/$(database)/documents/userProfiles/$(request.auth.uid);
      let tPath = /databases/$(database)/documents/tenants/$(tId);
      
      // 1. Primary Check: Profile association (direct)
      // Using .get() for field access is safer in case of missing fields
      let profileExists = exists(pPath);
      if (profileExists && get(pPath).data.get('tenantId', '') == tId) {
        return true;
      }

      // 2. Secondary Check: Owner via Token Email (Fastest source of truth for new stores)
      // We check the tenant document directly for the owner's email
      let email = request.auth.token.email;
      let tenantExists = exists(tPath);
      
      if (tenantExists) {
        let tenantData = get(tPath).data;
        let ownerEmail = tenantData.get('ownerEmail', '');
        if (email != null && ownerEmail != null && ownerEmail.lower() == email.lower()) {
          return true;
        }
      }
      
      return false;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /platform_broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Allow creation for any signed-in user initializing their store
      allow create: if isSignedIn();
      
      // Access allowed for verified members, owners, or super admins
      // For the tenant document itself, we can use resource.data if it exists for faster checks
      allow read, update: if isSignedIn() && (
        isSuperAdmin() || 
        (resource != null && request.auth.token.email != null && resource.data.get('ownerEmail', '').lower() == request.auth.token.email.lower()) ||
        isMemberOf(tenantId)
      );
      
      // Subcollection matches inherit parent context
      match /products/{productId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /transactions/{txId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /b2bClients/{clientId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
      match /reconciliations/{recId} {
        allow read, write: if isSignedIn() && (isMemberOf(tenantId) || isSuperAdmin());
      }
    }
  }
}